# ============================================================
# GRID — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grid
DB_USER=grid_user
DB_PASSWORD=changeme
ASTROGRID_DB_SCHEMA=astrogrid

# --- API Keys ---
FRED_API_KEY=your_fred_api_key_here
BLS_API_KEY=your_bls_registration_key_here

# --- Logging ---
LOG_LEVEL=INFO
ENVIRONMENT=development
GRID_DATA_ROOT=/data/grid
GRID_ASTROGRID_EXPORT_ROOT=/data/grid/archive/astrogrid
GRID_DOWNLOAD_LOG_ROOT=/data/grid/logs/downloads

# --- Pull Schedule (cron format) ---
PULL_SCHEDULE_FRED=0 18 * * 1-5
PULL_SCHEDULE_YFINANCE=30 18 * * 1-5
PULL_SCHEDULE_BLS=0 9 * * *

# --- Auth (REQUIRED for production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
GRID_JWT_SECRET=
# Generate with: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
GRID_MASTER_PASSWORD_HASH=

# --- TradingView ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRADINGVIEW_WEBHOOK_SECRET=

# --- International APIs ---
KOSIS_API_KEY=your_kosis_key_here
COMTRADE_API_KEY=your_comtrade_key_here
JQUANTS_EMAIL=your_email_here
JQUANTS_PASSWORD=your_password_here

# --- Physical / Alt Data ---
USDA_NASS_API_KEY=your_usda_nass_key_here
NOAA_TOKEN=your_noaa_token_here
EIA_API_KEY=your_eia_key_here
GDELT_API_KEY=your_gdelt_key_here

# --- Pull schedules for v2 sources ---
PULL_SCHEDULE_INTERNATIONAL=0 20 * * 1-5
PULL_SCHEDULE_TRADE=0 3 * * 0
PULL_SCHEDULE_PHYSICAL=0 4 1 * *
PULL_SCHEDULE_ALTDATA=30 20 * * 1-5

# --- OpenAI (preferred primary LLM) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Hermes analyst bridge (intelligence/hermes/) ---
# Hosted OpenAI reasoning model with spend accounting + local fallback; the
# bridge to a future fine-tuned grid-analyst-v1. NOT the hermes_operator daemon.
# Requires openai>=1.40. Verify with: python -m intelligence.hermes.cli ping
HERMES_ENABLED=true
HERMES_API_KEY=                       # blank -> reuse OPENAI_API_KEY
HERMES_BASE_URL=                      # blank -> reuse OPENAI_BASE_URL
HERMES_MODEL=gpt-4o                   # gpt-5.4 / o-series for batch reasoning
HERMES_TIMEOUT_SECONDS=120
HERMES_MAX_COMPLETION_TOKENS=4096
HERMES_TEMPERATURE=                   # blank -> omit (reasoning models reject it)
HERMES_REASONING_EFFORT=              # "", low, medium, high (o-series / gpt-5)
HERMES_DAILY_SPEND_CAP_USD=0.0        # 0 -> no cap; set before scheduler wiring
HERMES_LEDGER_PATH=outputs/hermes/spend_ledger.json
HERMES_PRICE_INPUT_PER_MTOK=2.50
HERMES_PRICE_OUTPUT_PER_MTOK=10.00
HERMES_FALLBACK_TIER=reason           # llm.router tier used when offline
# Backend select: "openai" (above, API key) or "codex" (ChatGPT/Codex
# subscription via the Codex CLI — the only path to GPT-5.5; no key, no USD
# cap, plan rate limits). For codex: `npm install -g @openai/codex` + `codex
# login` on the host running grid-hermes, then set HERMES_BACKEND=codex.
HERMES_BACKEND=openai                  # openai | codex
HERMES_CODEX_BIN=codex                 # Codex CLI binary (PATH or absolute)
HERMES_CODEX_MODEL=                    # blank -> Codex default (GPT-5.5)
HERMES_CODEX_TIMEOUT_SECONDS=240
HERMES_CODEX_EXTRA_ARGS=               # extra `codex exec` flags, e.g. "--model gpt-5.5"
# LLM second-opinion review of active hypotheses (scripts/hermes_llm_hypothesis_review.py).
# DORMANT by default; advisory layer over the free deterministic 30-min scorer.
# For unattended runs use the API-key lane (HERMES_BACKEND=openai + GRID_ALLOW_PAID_LLM=true
# + HERMES_DAILY_SPEND_CAP_USD). See intelligence/hermes/BACKEND_ROUTING.md.
HERMES_HYPO_LLM_ENABLED=false          # gate the LLM hypothesis second-opinion
HERMES_HYPO_LLM_LIMIT=10               # top-N highest-conviction active hypos per run

# --- llama.cpp (local LLM inference — GPU only) ---
# :8081 is the shim in front of the RTX 3090 llama-server on :8086.
# NOTE: there is no CPU-only :8080 tier any more — the grid-llamacpp unit was
# retired 2026-09-10 ("no CPU-only Qwens"). Never point this at :8080.
LLAMACPP_BASE_URL=http://localhost:8081
LLAMACPP_ENABLED=true
LLAMACPP_TIMEOUT_SECONDS=120
LLAMACPP_CHAT_MODEL=Qwen3.8-27B-Q4_K_M

# Total wall-clock budget (seconds) for one /chat/compose request's whole LLM
# attempt (local card + any paid failover). Default 18s matches the
# pre-fail-fast per-candidate timeout; lower once a healthy-card compose
# timing baseline is measured (see config.py's COMPOSE_LLM_BUDGET_S comment).
COMPOSE_LLM_BUDGET_S=18.0

# --- Embeddings (tailnet GPU Ollama nodes running nomic-embed-text) ---
# Tried left to right; the first node that answers wins. grid-svr's own Ollama
# ("ollama") is last because it shares the 3090 with the chat model.
# llm.router.embed() returns None when none answer — callers degrade gracefully.
#
# Reachability probed from grid-svr 2026-09-10:
#   gridz4:11434  ACTIVE  <- the "another machine on the tailnet"
#   koala:11434   offline 48d
#   z400:11434    not a tailnet peer
#   localhost     ACTIVE  <- last resort, shares the 3090
EMBED_PROVIDER_CHAIN=ollama_z4,ollama_koala,ollama_z400,ollama
EMBED_MODEL=nomic-embed-text
# Ollama on gridz4 — NOT the llama.cpp server on gridz4:8080 (LLAMACPP_Z4_*)
OLLAMA_Z4_BASE_URL=http://gridz4:11434
OLLAMA_Z4_ENABLED=true
# Enable these two once the boxes are back on the tailnet
OLLAMA_KOALA_BASE_URL=http://koala:11434
OLLAMA_KOALA_ENABLED=false
OLLAMA_Z400_BASE_URL=http://z400:11434
OLLAMA_Z400_ENABLED=false

# --- Ollama (grid-svr local — also the last-resort embed node) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_ENABLED=false

# --- Google Gemini (paid frontier; needs GRID_ALLOW_PAID_LLM=true to be used) ---
# Sits ahead of openrouter in every chat fallback chain.
GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=120

# --- Bookmark Intelligence Pipeline ---
# Multi-LLM triage: each bookmark analyzed by 3 models independently
GROQ_API_KEY=
GEMINI_API_KEY=
BOOKMARKS_DB_PATH=~/.ft-bookmarks/bookmarks.db
BOOKMARKS_OBSIDIAN_PATH=~/Documents/Obsidian Vault
BOOKMARKS_SYNC_ENABLED=true
BOOKMARKS_SYNC_CRON=23 7 * * *

# --- TradingAgents ---
# Set to true to enable the agent system. Uses OpenAI by default.
# Falls back to llama.cpp when OpenAI is not configured or unavailable.
AGENTS_ENABLED=true
AGENTS_LLM_PROVIDER=openai
AGENTS_LLM_MODEL=auto
AGENTS_DEBATE_ROUNDS=1
AGENTS_DEFAULT_TICKER=SPY
AGENTS_SCHEDULE_ENABLED=false
AGENTS_SCHEDULE_CRON=0 17 * * 1-5
# AGENTS_OPENAI_API_KEY=
# AGENTS_ANTHROPIC_API_KEY=

# Obsidian Bridge
OBSIDIAN_VAULT_PATH=~/Documents/Obsidian Vault
OBSIDIAN_SYNC_ENABLED=true

# Agent Reporting Hub
# Bearer token is read from /etc/agent-hub/token in production; do not commit it.
AGENT_HUB_TOKEN_FILE=/etc/agent-hub/token
AGENT_HUB_BUCKET=agent-reports
AGENT_HUB_OBSIDIAN_DEST=anikdang@100.120.20.120:/Users/anikdang/Documents/Obsidian Vault/00-Agent-Reports
# Optional production file for MinIO service credentials:
# /etc/agent-hub/minio.env with MINIO_ACCESS_KEY and MINIO_SECRET_KEY.

# MinIO / S3 blob store (docker-compose `minio` service, store/blob.py, agent_hub)
# Root credentials for the local MinIO container — `docker compose up` refuses to
# start without them. For local dev the app keys below are the same two values.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# TurboQuant KV Cache Quantization
TURBOQUANT_ENABLED=false
TURBOQUANT_BITS=3
TURBOQUANT_MODE=mse
FMP_API_KEY=your_fmp_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
CRYPTOQUANT_API_KEY=your_cryptoquant_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here
# Backup market data + headline counts (scripts/load_wave2.py, scripts/full_universe_pull.py)
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here
NEWSAPI_KEY=your_newsapi_key_here

# Dune Analytics (on-chain SQL; sign up at https://dune.com)
DUNE_API_KEY=your_dune_api_key_here
DUNE_QUERY_SMART_MONEY=0
DUNE_QUERY_CEX_FLOW=0
DUNE_QUERY_NARRATIVE_HEAT=0

# Robinhood crypto (trading/robinhood.py — official key-signed Crypto Trading API)
# 1) python -m trading.robinhood keygen   2) paste the PUBLIC key into the Robinhood
# app (Account → API) and copy the issued API key   3) set the two values below.
# Orders stay dry-run until ROBINHOOD_LIVE_TRADING=true.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY_B64=
ROBINHOOD_LIVE_TRADING=false
ROBINHOOD_MAX_POSITION_USD=100
ROBINHOOD_MAX_DRAWDOWN_PCT=0.20

# Alert / digest email (alerts/email.py, scripts/daily_digest.py)
# GRID sends as the Hermes mailbox through its provider's authenticated SMTP.
# The app password is set on the server only — never commit it.
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_TO=stepdadfinance@gmail.com
ALERT_EMAIL_FROM=hermes@stepdad.finance
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USE_TLS=true
ALERT_SMTP_USER=hermes@stepdad.finance
ALERT_SMTP_PASSWORD=
