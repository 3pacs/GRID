# Turn npm's default EBADENGINE warning into a hard failure. Every installed
# package's engines.node range is checked -- vitest's ^22.12.0 || ^24.0.0 ||
# >=26.0.0 among them -- so an unsupported Node version fails `npm ci` here
# instead of silently installing anyway. Applies identically wherever this
# file's directory runs `npm ci`/`npm install`: CI's Frontend Build and
# deploy.yml's Build release tree both do, from this same pwa/ directory.
engine-strict=true
