# Langfuse self-hosted stack — copy to .env and fill in real values.
# Generate secrets with: openssl rand -hex 32  (use hex for ALL passwords)
# IMPORTANT: ClickHouse password must contain ONLY hex/alphanumeric chars.
# Special characters (+ / = & % @ space etc.) break the migration URL parser.

NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
SALT=replace-with-openssl-rand-hex-32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
POSTGRES_PASSWORD=replace-with-alphanumeric-only
CLICKHOUSE_PASSWORD=replace-with-hex-only
REDIS_PASSWORD=replace-with-alphanumeric-only
MINIO_PASSWORD=replace-with-alphanumeric-only

# UI URL the auth cookies bind to. Must match how users reach the box.
NEXTAUTH_URL=http://grid-svr:3000
