# TEMPLATE. placement: pinned-checkout user unit (see deploy/systemd-user/README.md).
# A copy of this unit runs on grid-svr as a `grid` USER unit since 2026-11-19, on the owner's
# word. It records what the Research Desk's sources said after each session close. It reads
# the database and the factory ledger and appends only to its own folder.
#
# It does NOT run from the release tree, on purpose. The release tree moves to `main` on every
# deploy; this job writes an append-only log whose format must not change under it, so it runs
# from a checkout pinned to one reviewed commit and moves only when a person moves it. That is
# why it lives in deploy/systemd-user/ and not deploy/systemd/, whose templates must all run
# from /data/grid_v4/grid_release (tests/test_systemd_template_invariants.py, unchanged).
# This directory has its own guard: tests/test_systemd_user_template_invariants.py.
#
# Install (as grid, no sudo; linger is on):
#   sed "s#@CODE@#<pinned checkout>#g" deploy/systemd-user/grid-desk-receipts.service.template \
#       > ~/.config/systemd/user/grid-desk-receipts.service
#   cp deploy/systemd-user/grid-desk-receipts.timer.template ~/.config/systemd/user/grid-desk-receipts.timer
#   systemctl --user daemon-reload && systemctl --user enable --now grid-desk-receipts.timer
# Moving to a new commit: make a new pinned checkout, point @CODE@ at it, daemon-reload.
# Make the checkout under `umask 022`. grid's default is 002, which leaves the pinned calendar
# file group-writable; the job refuses a group-writable calendar and would then refuse every
# session (exit 2, no receipt). Check: stat -c %a docs/reference/calendar-manifests/xnys-rth-*.json
# must print 644.
# The log folder never moves and is never recreated.
[Unit]
Description=GRID Research Desk source receipt (latest closed session, read-only on sources, append-only log)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=@CODE@
EnvironmentFile=/home/grid/grid_v4/grid_repo/.env
Environment=PYTHONUNBUFFERED=1
Environment=DESK_RECEIPTS_DIR=/data/grid_ledgers/desk-receipts
Environment=DESK_FACTORY_LEDGER=/data/grid_ledgers/factory/ledger/grid-module-factory.jsonl
Environment=DESK_FACTORY_ANCHOR=/data/grid_ledgers/factory/anchor/grid-module-factory.anchors.jsonl
# The live trial ledger (gex-signals), opened read-only. The copy running since 2026-11-19 predates this
# line: it takes effect when the owner moves the unit to a pinned checkout that has the source (#1162).
Environment=DESK_PANEL_TRIALS_DB=/data/agent-home/anikdang/gex-signals-data/signals.db
Environment=DESK_RECEIPTS_PYTHON=/data/grid_v4/grid_venv-314/bin/python
ExecStart=/usr/bin/flock -n /tmp/grid-desk-receipts.lock /bin/bash @CODE@/scripts/desk_receipts_run.sh
# Off-host witness (2026-11-21): after every run, failed runs included, export the anchor lines to the
# dedicated vault clone, commit only 05-GRID/Paper-Log/desk-receipts/ and push it, so the factory
# pre-screen look can verify against the pushed copy (scripts/desk_receipts_witness_sync.sh).
# The clone must exist first: git clone 3pacs/obsidian-vault /home/grid/dev/obsidian-vault-deskwitness.
ExecStopPost=/bin/bash @CODE@/scripts/desk_receipts_witness_sync.sh /home/grid/dev/obsidian-vault-deskwitness
TimeoutStopSec=5min
TimeoutStartSec=10min
Nice=10
StandardOutput=journal
StandardError=journal
