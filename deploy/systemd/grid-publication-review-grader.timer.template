# TEMPLATE -- see grid-publication-review-grader.service.template for the install lines.
#
# Fires daily at 11:35Z: an hour after the packet producer (10:35Z + up to 2 min random
# delay) and outside the nightly encrypted Postgres backup window (03:30-10:30 UTC;
# tests/test_systemd_template_invariants.py). The grader hands each written review to
# the ingest itself; grid-publication-review-ingest.timer (13:05Z) stays as the safety
# net for a review the grader wrote but could not ingest (database unreachable).
# If grid-publication-packet.timer moves, move this timer with it.
# deploy-sync: managed  (deploys reinstall this unit when the template changes; see deploy/systemd/README.md)
[Unit]
Description=Grade the previous days' GRID publications into review.jsonl

[Timer]
OnCalendar=*-*-* 11:35:00 UTC
RandomizedDelaySec=2min
Persistent=true
Unit=grid-publication-review-grader.service

[Install]
WantedBy=timers.target
