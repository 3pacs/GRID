# TEMPLATE — NOT INSTALLED. See grid-regime-state-vectors.service.template.
# Weekdays 23:00Z -- well after the US market close (20:00-21:00 UTC
# depending on DST), so the "prior completed session" the job resolves
# (today - 1 trading day) is always fully closed by the time this fires.
[Unit]
Description=Run the GRID regime state-vector writer once a weekday evening

[Timer]
OnCalendar=Mon..Fri *-*-* 23:00:00 UTC
RandomizedDelaySec=5min
Persistent=true
Unit=grid-regime-state-vectors.service

[Install]
WantedBy=timers.target
