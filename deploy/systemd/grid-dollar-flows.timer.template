# feedback-grid-migration-backup-window.md undersold it) — 30 minutes after
# grid-causal-links.timer (also moved off its old 07:40 UTC slot in this
# same PR for the same reason; see #712 review).
[Unit]
Description=Run the GRID dollar-flows normalizer once a day

[Timer]
OnCalendar=*-*-* 11:45:00 UTC
RandomizedDelaySec=5min
Persistent=true
Unit=grid-dollar-flows.service

[Install]
