# TEMPLATE — NOT INSTALLED. Installing this unit (and its .timer) is the
# activation step for slice N2 and needs an explicit operator decision.
# Install (on grid-svr, after `alembic upgrade head` has applied
# causal_links_provenance_20260927):
#   sudo cp deploy/systemd/grid-causal-links.service.template /etc/systemd/system/grid-causal-links.service
#   sudo cp deploy/systemd/grid-causal-links.timer.template   /etc/systemd/system/grid-causal-links.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now grid-causal-links.timer
# WorkingDirectory follows grid-godview-*.service and
# grid-analytics-snapshots.service.template (the deployed release tree),
# not the old /home/grid/grid_v4/grid_repo convention this template used
# to use — that checkout is stale/diverged and no live service runs from it
# (systemd template sweep, 2026-09-28; same finding as PR #712/#713/#714
# review for grid-dollar-flows/grid-market-diary/grid-regime-state-vectors).
[Unit]
Description=GRID causal-link writer (preceding public events per trade, point-in-time)
After=network.target postgresql.service

[Service]
Type=oneshot
User=grid
# The deployed release tree (same tree grid-api runs from; .github/workflows/
# deploy.yml resets it to main) — not the old /home/grid/grid_v4/grid_repo
# checkout, which is stale/diverged.
WorkingDirectory=/data/grid_v4/grid_release
# Same env file grid-scheduler, grid-hermes and the godview writers use
# (GRID DB settings) — this file itself still lives in the repo checkout.
EnvironmentFile=/home/grid/grid_v4/grid_repo/.env
Environment=PYTHONUNBUFFERED=1
# Bounded: <=500 most recently active tickers, 25 per transaction, idempotent upsert.
ExecStart=/usr/bin/flock -n /tmp/grid-causal-links.lock /usr/bin/python3 scripts/run_causal_links.py --days 30 --max-tickers 500 --batch-size 25
TimeoutStartSec=20min
Nice=10
StandardOutput=journal
StandardError=journal
