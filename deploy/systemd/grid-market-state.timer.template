# Weekdays 23:15Z: after the close and after the 23:00Z state-vector writer, so the prior session is complete.
[Unit]
Description=Run the GRID market-state record writer once a weekday evening

[Timer]
OnCalendar=Mon..Fri *-*-* 23:15:00 UTC
RandomizedDelaySec=5min
Persistent=true
Unit=grid-market-state.service

[Install]
WantedBy=timers.target
