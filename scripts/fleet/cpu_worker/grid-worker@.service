# GRID CPU compute worker, one process per instance (slice S4, 2026-11-06).
#
# scripts/worker.py runs jobs on a ThreadPoolExecutor inside one interpreter, so a single process tops out near one
# core (the GIL): measured 2026-11-05, grid-svr's worker sat at 100% CPU and gridz4's two job threads at ~32% each.
# CPU throughput therefore scales with processes, not --max-concurrent: run N instances of this template with
# --max-concurrent 1. Each instance registers with the coordinator as <host>-w<N> (registration upserts by hostname).
#
# Install: /etc/systemd/system/grid-worker@.service + grid-worker.slice, env in /etc/grid/grid-worker.env (root 0600),
# release + venv from install_release.sh, then: systemctl enable --now grid-worker@{1..N}
# Per-node CPU caps (e.g. threadripper, shared with a render farm and CI) go in grid-worker.slice.d/ as CPUQuota=.
[Unit]
Description=GRID CPU compute worker %i
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=gridworker
Group=gridworker
Slice=grid-worker.slice
WorkingDirectory=/opt/grid/release
EnvironmentFile=/etc/grid/grid-worker.env
Environment=HOME=/opt/grid/home
Environment=PYTHONPATH=/opt/grid/release
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 POLARS_MAX_THREADS=1
Environment=GRID_WORKER_SKIP_OLLAMA_GENERATE_PROBE=1
ExecStart=/opt/grid/venv-312/bin/python scripts/worker.py \
    --coordinator http://100.75.185.36:8100 \
    --hostname %H-w%i \
    --max-concurrent 1 \
    --exclude-types HUMAN_LLM_QUERY,LLM_INFERENCE,EMBEDDING_BATCH,KILL_PREDICTOR_SCORE,DATA_PULL
Nice=10
Restart=always
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
# Hides /dev/nvidia*: the worker then registers without a GPU and never claims requires_gpu jobs (GPUs belong to
# other services, e.g. x99-hex's LLM serving).
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
MemoryHigh=3G
MemoryMax=4G

[Install]
WantedBy=multi-user.target
