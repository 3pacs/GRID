[Unit]
Description=AstroGrid API (isolated)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=grid
Group=grid
WorkingDirectory=/data/grid_v4/astrogrid_dedup
EnvironmentFile=/data/grid_v4/astrogrid_dedup/.env
ExecStart=/usr/bin/python3 -m uvicorn astrogrid_api.main:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=5
StandardOutput=append:/data/grid/logs/astrogrid-api.log
StandardError=append:/data/grid/logs/astrogrid-api.log

[Install]
WantedBy=multi-user.target
