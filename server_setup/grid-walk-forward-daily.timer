[Unit]
Description=Run GRID walk-forward backtest every night (90d window)

[Timer]
# 03:30 UTC daily — after hermes 02:00 batch and intelligence 02:45 research.
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=5min
Persistent=true
Unit=grid-walk-forward-daily.service

[Install]
WantedBy=timers.target
