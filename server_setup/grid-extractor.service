[Unit]
Description=GRID Signal Extractor (raw_series → signal_data with actors)
After=network.target postgresql.service
Wants=grid-api.service

[Service]
Type=simple
User=grid
WorkingDirectory=/home/grid/grid_v4/grid_repo
EnvironmentFile=/home/grid/grid_v4/grid_repo/.env
ExecStart=/usr/bin/python3 -m intelligence.signal_extractor
Restart=always
RestartSec=30
StandardOutput=append:/data/grid/logs/extractor.log
StandardError=append:/data/grid/logs/extractor.log

[Install]
WantedBy=multi-user.target
