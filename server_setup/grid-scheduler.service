[Unit]
Description=GRID Data Ingestion Scheduler
After=grid-db.service grid-api.service
Requires=grid-db.service

[Service]
Type=simple
User=grid
WorkingDirectory=/home/grid/grid_v4/grid_repo/grid
EnvironmentFile=/home/grid/grid_v4/grid_repo/grid/.env
ExecStartPre=/home/grid/grid_v4/grid_repo/grid/venv/bin/python db.py
ExecStart=/home/grid/grid_v4/grid_repo/grid/venv/bin/python -m ingestion.scheduler
Restart=always
RestartSec=30
WatchdogSec=600
StandardOutput=append:/data/grid/logs/grid-scheduler.log
StandardError=append:/data/grid/logs/grid-scheduler.log

[Install]
WantedBy=multi-user.target
