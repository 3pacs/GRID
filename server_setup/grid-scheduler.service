[Unit]
Description=GRID Data Ingestion Scheduler
After=grid-api.service
Wants=grid-api.service

[Service]
Type=simple
User=grid
WorkingDirectory=/home/grid/grid_v4/grid_repo
EnvironmentFile=/home/grid/grid_v4/grid_repo/.env
ExecStart=/usr/bin/python3 -m ingestion.scheduler
Restart=always
RestartSec=30
StandardOutput=append:/data/grid/logs/grid-scheduler.log
StandardError=append:/data/grid/logs/grid-scheduler.log

[Install]
WantedBy=multi-user.target
