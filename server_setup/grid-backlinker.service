[Unit]
Description=GRID Signal Backlinker (signal → actor graph loop)
After=network.target postgresql.service grid-api.service
Wants=grid-api.service

[Service]
Type=simple
User=grid
WorkingDirectory=/home/grid/grid_v4/grid_repo
EnvironmentFile=/home/grid/grid_v4/grid_repo/.env
ExecStart=/usr/bin/python3 -m intelligence.signal_backlinker --interval 300 --lookback-minutes 1440 --batch-size 500 --trust-every 12
Restart=always
RestartSec=30
StandardOutput=append:/data/grid/logs/backlinker.log
StandardError=append:/data/grid/logs/backlinker.log

[Install]
WantedBy=multi-user.target
