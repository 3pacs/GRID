[Unit]
Description=GRID walk-forward backtest — daily short window (90d)
After=grid-api.service postgresql.service
Wants=grid-api.service

[Service]
Type=oneshot
User=grid
WorkingDirectory=/home/grid/grid_v4/grid_repo
EnvironmentFile=/home/grid/grid_v4/grid_repo/.env
ExecStart=/usr/bin/flock -n /tmp/grid-walk-forward-daily.lock /usr/bin/python3 -m scripts.walk_forward_validate --days 90 --horizon-days 7
StandardOutput=append:/data/grid/logs/grid-walk-forward-daily.log
StandardError=append:/data/grid/logs/grid-walk-forward-daily.log

[Install]
WantedBy=multi-user.target
