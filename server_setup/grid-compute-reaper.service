[Unit]
Description=GRID compute reaper — reclaim stale coordinator jobs
After=network.target postgresql.service grid-coordinator.service
Wants=grid-coordinator.service

[Service]
Type=oneshot
User=grid
WorkingDirectory=/home/grid/grid_v4/grid_repo
EnvironmentFile=/home/grid/grid_v4/grid_repo/.env
ExecStart=/usr/bin/flock -n /tmp/grid-compute-reaper.lock /usr/bin/python3 scripts/compute_job_reaper.py --grace-seconds 300 --limit 100
TimeoutStartSec=2min
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
