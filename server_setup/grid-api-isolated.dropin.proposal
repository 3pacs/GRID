# SOURCE TEMPLATE ONLY: must not be installed while launcher exits78.
# Resolve actual API identity, environment/config/state paths and effective unit
# before replacing these proposed fields. Never install this for grid-hermes.
[Service]
User=grid-api-isolated
WorkingDirectory=/data/grid_v4/api-isolated
ExecStart=
ExecStart=/data/grid_v4/api-isolated/bootstrap/bin/python3.10 -I -S -B /data/grid_v4/api-isolated/bootstrap/deploy_api_launcher.py --execute
# Existing EnvironmentFile/config ownership must be independently bound; no
# credential values or guessed config paths belong in this source proposal.
# Runtime bootstrap and release package environments are physically independent.
